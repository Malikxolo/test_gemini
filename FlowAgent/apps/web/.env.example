# Environment Variables Template
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# SECURITY: API KEY ENCRYPTION (CRITICAL)
# ============================================
# This key is used to encrypt/decrypt API keys stored in the database
# Requirements:
# - Minimum 32 characters
# - Keep it secret and secure
# - Use a different key for production
# - NEVER commit this to git
#
# Generate a secure key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
ENCRYPTION_KEY=change-this-to-a-secure-32-char-key!!

# ============================================
# OPTIONAL: PAYMENT INTEGRATION
# ============================================
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# ============================================
# SECURITY NOTES
# ============================================
# 1. ENCRYPTION_KEY is server-side only (not NEXT_PUBLIC_)
# 2. API keys are encrypted with AES-256-GCM before storage
# 3. Decryption only happens on server-side API routes
# 4. Client never sees decrypted API keys
# 5. All LLM API calls go through /api/chat endpoint
# 6. RLS policies protect database access
# 7. HTTPS required in production