# Database
DATABASE_URL=postgresql://user:password@host:5432/flowagent

# Neon Postgres (Serverless)
# Get from: https://console.neon.tech
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Upstash Redis
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Upstash QStash (Queue)
# Get from: https://console.upstash.com/qstash
QSTASH_TOKEN=xxx
QSTASH_CURRENT_SIGNING_KEY=xxx
QSTASH_NEXT_SIGNING_KEY=xxx

# Lambda
LAMBDA_ENDPOINT=https://xxx.execute-api.us-east-1.amazonaws.com/production
LAMBDA_WEBHOOK_URL=https://your-api.workers.dev/webhooks/qstash/execute

# Serper (Web Search)
# Get from: https://serper.dev
SERPER_API_KEY=xxx

# OpenAI
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# Anthropic (Claude)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# Cloudflare (Optional)
CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_API_TOKEN=xxx

# Razorpay (for $10 payments) - RECOMMENDED for India
# Get from: https://dashboard.razorpay.com
# Supports: UPI, Cards, Net Banking, Wallets + International cards
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Stripe (legacy/optional - NOT available in India)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# BYOK Encryption
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-64-character-hex-string-here

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:3000

# AWS (for Lambda deployment)
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=us-east-1
